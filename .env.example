# Copy to .env. Loaded by `npm start` (which passes --env-file). Node's parser
# does not reliably strip an inline `# comment` after a value — keep comments on
# their own line.

# Tokens come from the farmer pool (farmer/output/tokens.txt), not from here.
# Leave empty unless you are overriding the pool by hand.
QWEN_TOKENS=

# Listen port.
PORT=8787

# Bind address. Loopback on purpose: every route answers with
# `Access-Control-Allow-Origin: *` and the proxy holds live account tokens, so
# 0.0.0.0 exposes an unauthenticated relay to the whole network.
QWEN_HOST=127.0.0.1

# Surface the model's reasoning in the output. The request still enables
# thinking (see README "Thinking / fast mode") — this only controls display.
QWEN_THINKING=false

# The chat.qwen.ai frontend version, sent as the required "Version" header.
# Stale values get WAF-rejected; copy the real one from DevTools > Network if
# completions start failing.
QWEN_CLIENT_VERSION=0.2.83

# Wipe the memories Qwen auto-saves server-side after each turn.
QWEN_FORGET_MEMORIES=false

# WAF cookies are minted by ssxmod.js + puppeteer-stealth. Leave empty.
QWEN_COOKIES=

# Parallel browser contexts for the Puppeteer fallback. 2 measured 2.3x
# throughput with no captcha-rate increase once contexts are warm.
QWEN_WORKERS=2

# Where generated/edited images land.
QWEN_ARTIFACT_DIR=./generated

# Server-side conversation memory for clients that send a conversation id.
MEMORY_FILE=./memory.json

# --- debugging; leave disarmed in normal operation -------------------------

# Append every raw SSE event as JSONL. See README "Debugging playbook".
# QWEN_DEBUG_SSE_FILE=./sse_debug.jsonl

# Verbose payload logging. Required by test_client_thread.js, which reads
# payload_dump.json — a stale dump makes that test fail spuriously.
# QWEN_DEBUG=1
